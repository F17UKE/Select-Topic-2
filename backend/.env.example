# Secret-free template copied to /etc/select-topic-2/backend.env by setup-backend.sh.
# Cloud backend binds only to its private interface. Use .env.local.example locally.
HOST=10.0.7.6
PORT=3001
NODE_ENV=production
CUSTOMER_AUTH_MODE=line
ENABLE_DEV_LOGIN=false
MERCHANT_STAFF_AUTH_MODE=password
ENABLE_STAFF_DEV_LOGIN=false
# LINE Login / LIFF and Messaging API. Fill only on the backend host.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=
LINE_MESSAGING_MODE=real
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Optional override when the Messaging API webhook channel uses a different secret.
LINE_WEBHOOK_SECRET=
# Public HTTPS app/LIFF base used by notification CTA links.
APP_PUBLIC_URL=
TRUST_PROXY_HOPS=1

# Live adapters: checkslip (backward compatible) or easyslip. Production rejects mock.
PAYMENT_VERIFICATION_MODE=checkslip
SLIP_STORAGE_MODE=object
SLIP_OBJECT_STORAGE_ENDPOINT=
SLIP_OBJECT_STORAGE_REGION=
SLIP_OBJECT_STORAGE_BUCKET=
SLIP_OBJECT_STORAGE_ACCESS_KEY=
SLIP_OBJECT_STORAGE_SECRET_KEY=
# true is commonly required by MinIO and other S3-compatible providers.
SLIP_OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Optional private CA bundle path. TLS verification always remains enabled.
SLIP_OBJECT_STORAGE_CA_FILE=
# SlipOK Check Slip v1.8 full branch endpoint. Replace placeholders on the backend host only.
CHECKSLIP_API_URL=https://api.slipok.com/api/line/apikey/YOUR_BRANCH_ID
CHECKSLIP_API_KEY=
CHECKSLIP_CONNECT_TIMEOUT_MS=3000
CHECKSLIP_REQUEST_TIMEOUT_MS=10000
# Keep private files outside the public web root. Empty uses backend/storage.
SLIP_STORAGE_DIR=
SLIP_MAX_BYTES=4194304
PAYMENT_PRIVATE_RETENTION_HOURS=24

# EasySlip v2; opt-in only. Do not switch modes without verified merchant mappings.
EASYSLIP_API_BASE_URL=https://api.easyslip.com/v2
EASYSLIP_API_KEY=
EASYSLIP_CONNECT_TIMEOUT_MS=3000
EASYSLIP_REQUEST_TIMEOUT_MS=10000
# Protected JSON object keyed by merchant ID. Each entry: promptpayType, promptpayId,
# bankCode, bankNumber. Use exact registered/full recipient values, never masked guesses.
# Empty mapping blocks real verification BEFORE upload/provider request.
EASYSLIP_MERCHANT_ACCOUNTS={}

# Fill these on the BACKEND host only. No real values belong in Git.
DB_HOST=10.0.7.7
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Safe production default. Use disable only when the DB provider explicitly requires
# plaintext on an approved private network.
DB_SSL_MODE=verify-full
# PEM file path on backend; used only with verify-full. Empty uses system CAs.
DB_SSL_CA_FILE=
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=2000
# Existing integration values remain ENV fallbacks; Super Admin may override supported fields.
# Bootstrap only: base64 of 32 cryptographically random bytes, stored outside Git.
# Never store this master key in the DB. Back it up separately before saving encrypted settings.
# Empty in development creates/reuses backend/.runtime/integration-settings.key.
# Production never generates keys. Set the ENV key above OR an existing persistent file below.
INTEGRATION_SETTINGS_ENCRYPTION_KEY=
# Absolute path; file contains the same base64 key. POSIX mode 600, owned by service user.
INTEGRATION_SETTINGS_KEY_FILE=
