HOST=127.0.0.1
PORT=3001
NODE_ENV=development
CUSTOMER_AUTH_MODE=mock
ENABLE_DEV_LOGIN=true
DEV_CUSTOMER_LINE_USER_ID=U_LOCAL_CUSTOMER_001
MERCHANT_STAFF_AUTH_MODE=mock
ENABLE_STAFF_DEV_LOGIN=true
DEV_MERCHANT_STAFF_USERNAME=local_manager
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=
LINE_MESSAGING_MODE=disabled
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_WEBHOOK_SECRET=
APP_PUBLIC_URL=http://127.0.0.1:3000
TRUST_PROXY_HOPS=0
PAYMENT_VERIFICATION_MODE=mock
SLIP_STORAGE_MODE=local
# Object mode only: endpoint, region, bucket and credentials are required.
SLIP_OBJECT_STORAGE_ENDPOINT=
SLIP_OBJECT_STORAGE_REGION=
SLIP_OBJECT_STORAGE_BUCKET=
SLIP_OBJECT_STORAGE_ACCESS_KEY=
SLIP_OBJECT_STORAGE_SECRET_KEY=
SLIP_OBJECT_STORAGE_FORCE_PATH_STYLE=false
SLIP_OBJECT_STORAGE_CA_FILE=
# Required only when PAYMENT_VERIFICATION_MODE=checkslip. Never commit real values.
CHECKSLIP_API_URL=
CHECKSLIP_API_KEY=
CHECKSLIP_CONNECT_TIMEOUT_MS=3000
CHECKSLIP_REQUEST_TIMEOUT_MS=10000
# Relative paths resolve from the backend process working directory; empty uses backend/storage.
SLIP_STORAGE_DIR=
SLIP_MAX_BYTES=5242880
PAYMENT_PRIVATE_RETENTION_HOURS=24

# Local Docker PostgreSQL only. This known value must never be reused outside local development.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=select_topic_2_local
DB_USER=select_topic_2_local
DB_PASSWORD=select_topic_2_local_only
DB_SSL_MODE=disable
DB_SSL_CA_FILE=
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=2000
# Development auto-manages backend/.runtime/integration-settings.key when these are empty.
# Preserve that ignored file to decrypt settings after restart. ENV key takes priority.
INTEGRATION_SETTINGS_ENCRYPTION_KEY=
INTEGRATION_SETTINGS_KEY_FILE=
