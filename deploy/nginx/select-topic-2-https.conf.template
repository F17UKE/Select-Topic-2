# Render placeholders only after DNS and certificate paths are known.
server {
    listen 80;
    listen [::]:80;
    server_name __PRODUCTION_DOMAIN__;
    return 308 https://__PRODUCTION_DOMAIN__$request_uri;
}

server {
    # Ubuntu 24.04 ships nginx 1.24 (before the standalone http2 directive).
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __PRODUCTION_DOMAIN__;
    server_tokens off;

    ssl_certificate __TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # This header belongs only on the HTTPS virtual host after TLS is live.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 11m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;

    location = /api { return 308 /api/; }
    location = /api/webhooks/line {
        proxy_pass http://10.0.7.6:3001;
        proxy_cache off;
    }
    location ^~ /api/ {
        proxy_pass http://10.0.7.6:3001;
        proxy_cache off;
    }
    location = /webhooks/line {
        proxy_pass http://10.0.7.6:3001;
        proxy_cache off;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_buffering off;
    }
}
